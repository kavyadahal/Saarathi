import json
import numpy as np
import pandas as pd



class Student:
    def __init__(self,name:str,scores:list[int]):
        self.name = name
        self.scores = scores
    def average(self) ->float:
        return float(np.mean(self.scores))
    def grade(self):
        if self.score>=40:
            return "B"
        if self.score>=70:
            return "A"
        if self.score>=40:
